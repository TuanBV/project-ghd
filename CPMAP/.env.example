# ===== Database =====
DB_NAME=mcprice
DB_USERNAME=mcprice
DB_PASSWORD=mcprice
DB_PORT=15432

# ===== Backend =====
BACKEND_PORT=8080
JWT_SECRET=dev-only-change-me-please-32bytes-minimum
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ===== Frontend =====
FRONTEND_PORT=3001

# ===== Publish - Website (mac dinh DRY_RUN=true, khong goi API thuc) =====
WEBSITE_DRY_RUN=true
# MOCK | WOOCOMMERCE
WEBSITE_PUBLISHER_PROVIDER=MOCK
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ===== Publish - Google Merchant Center (mac dinh DRY_RUN=true, khong goi API thuc) =====
MERCHANT_DRY_RUN=true
# MOCK | GOOGLE_API
MERCHANT_PUBLISHER_PROVIDER=MOCK
MERCHANT_ACCOUNT_ID=
MERCHANT_DATA_SOURCE_ID=
MERCHANT_CREDENTIALS_PATH=

# ===== Job =====
# Cron job tong hang ngay, gio Asia/Ho_Chi_Minh (mac dinh 02:00)
DAILY_PIPELINE_CRON=0 0 2 * * ?
