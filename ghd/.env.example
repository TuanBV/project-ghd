# Copy this file to `.env` and fill in real values before running `docker compose up`.
# `.env` is git-ignored - never commit real secrets.
#
# IMPORTANT: src/main/resources/application.properties previously contained real
# credentials/tokens committed to git history (DB password, JWT secret, AES key,
# Gmail app password, Telegram bot token). Those values have been moved to
# environment variables. Because they were committed in plain text before, treat
# them as compromised and ROTATE all of them (new DB password, new JWT/AES secrets,
# new Gmail app password, new Telegram bot token) before using this app anywhere
# beyond a throwaway local/dev environment.

# ---- Application ----
# local | docker | staging | production - used for cache/session key namespacing
APP_ENV=local

# Salt used to hash visitor IPs in the analytics tracker before storing them - change
# this in production so hashed IPs can't be reversed via a rainbow table.
ANALYTICS_IP_SALT=change-me-in-production

# ---- MySQL ----
# compose.yaml (default, local/dev) always uses the containerized `mysql` service and
# ignores DB_HOST/DB_PORT below (hardcoded to mysql:3306 in compose.yaml).
# compose.external-db.yaml (MySQL running outside Docker, e.g. on a VPS) DOES read
# these - set DB_HOST to `host.docker.internal` or the host's private IP. See
# docs/DOCKER.md "Using an external MySQL (VPS)".
DB_HOST=mysql
DB_PORT=3306
DB_NAME=core
DB_USERNAME=ghd_app
DB_PASSWORD=change-me-app-password
# Used only by the mysql container itself (root superuser), the app never uses it
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- Redis (compose service: redis) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ---- JWT / AES ----
# Generate new random secrets, e.g.: openssl rand -hex 64
JWT_SECRET=change-me-jwt-secret-min-64-bytes-hex
AES_SECRET=change-me-aes-secret-min-64-bytes-hex

# ---- Cookies / sessions ----
COOKIE_DOMAIN=localhost
SESSION_TIMEOUT=30m
SESSION_COOKIE_NAME=GHDSESSION
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# ---- Mail (Gmail SMTP app password, not the account password) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- VNPay (card + installment payment) ----
# No sandbox/merchant account provisioned yet - see .claude/skills/vnpay-payment/SKILL.md
# and docs/PROCESSING-FLOW.md. Do not invent values; leave blank until real merchant
# credentials exist.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_API_URL=
# Absolute base URL this app is reachable at - used to build the VNPay return URL.
APP_BASE_URL=http://localhost:18080
# Phase 2: auto-cancel AWAITING_PAYMENT orders past this many minutes with no payment
# confirmation, and how far back the (currently scaffold-only) reconciliation job looks.
ORDER_PAYMENT_TTL_MINUTES=15
PAYMENT_RECONCILE_GRACE_MINUTES=3
CANCEL_STALE_ORDERS_FIXED_DELAY_MS=60000
RECONCILE_PENDING_FIXED_DELAY_MS=300000

# ---- Storage paths (inside the app container) ----
UPLOAD_PATH=/app/uploads
SEO_STATIC_PATH=/app/seo
LOG_PATH=/app/logs

# ---- Ports published to the host ----
APP_PORT=18080
